# Supabase environment variables for the backend (Edge Functions)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Settlement period in milliseconds (default 5000)
SETTLEMENT_MS=5000

# Frontend environment variables (Vite)
VITE_API_BASE_URL=https://api.clirevenue.in
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# CLIRevenue SDK (browser-safe, publishable only)
#
# The publishable publisher key the SDK initialises with. It must match
# /^pk_(live|test)_[A-Za-z0-9_-]{32,}$/ and identifies the publisher for
# delivery, impression and click. It is publishable by design.
#
# NEVER put the Supabase service-role key, AD_TOKEN_SECRET or
# SETTLEMENT_SECRET in a VITE_ variable — Vite inlines every VITE_ value
# into the client bundle, which would ship those secrets to every visitor.
# Only server-side code may hold them.
#
# Leave it unset to run the console with no delivery: the sponsored slot
# renders its honest "not configured" state instead of a broken panel.
VITE_CLIREVENUE_PUBLISHABLE_KEY=pk_test_your_32_char_publisher_key_here
