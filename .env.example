# Supabase environment variables for the backend (Edge Functions)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Settlement period in milliseconds (default 5000)
SETTLEMENT_MS=5000

# Frontend environment variables (Vite)
VITE_API_BASE_URL=https://xoacisojqsqlqzvzzusx.supabase.co/functions/v1
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# CLIRevenue SDK (browser-safe, publishable only)
#
# The publishable publisher key the SDK initialises with. It must match
# /^pk_(live|test)_[A-Za-z0-9_-]{32,}$/ and identifies the publisher for
# delivery, impression and click. It is publishable by design.
#
# NEVER put the Supabase service-role key, AD_TOKEN_SECRET or
# SETTLEMENT_SECRET in a VITE_ variable — Vite inlines every VITE_ value
# into the client bundle, which would ship those secrets to every visitor.
# Only server-side code may hold them.
#
# Leave it unset to run the console with no delivery: the sponsored slot
# renders its honest "not configured" state instead of a broken panel.
VITE_CLIREVENUE_PUBLISHABLE_KEY=pk_test_your_32_char_publisher_key_here

# The public ad gateway the SDK talks to, and the ONLY base the SDK uses.
#
# Leave it unset in production. The SDK then defaults to its own
# DEFAULT_BASE_URL, https://api.clirevenue.in, which is the intended public
# routing. Do NOT point it at VITE_API_BASE_URL: that variable is the
# internal backend this app calls with a user JWT (campaigns, rewards,
# payouts, contacts), and reusing it as the gateway base is what made
# production browser delivery and telemetry bypass api.clirevenue.in.
#
# Set it in .env.local only when running against a local backend that is not
# reachable at the public gateway.
# VITE_AD_GATEWAY_URL=https://<project-ref>.supabase.co/functions/v1

# ---------------------------------------------------------------------
# FILEBASE — advertiser creative object storage (server-only)
# ---------------------------------------------------------------------
# Filebase is S3-compatible and is the authoritative store for uploaded
# advertiser creatives. The browser never sees any of these values.
#
# The `creatives` Edge Function signs every upload and every read with
# SigV4, so the browser receives a short-lived presigned URL for ONE
# server-derived object key and nothing else.
#
# These belong in Supabase function secrets (`supabase secrets set ...`),
# not in a VITE_ variable and not in this file with real values:
#
#   supabase secrets set \
#     FILEBASE_ENDPOINT=https://s3.filebase.com \
#     FILEBASE_BUCKET=clirevenue-creatives \
#     FILEBASE_REGION=us-east-1 \
#     FILEBASE_ACCESS_KEY_ID=... \
#     FILEBASE_SECRET_ACCESS_KEY=...
#
# `filebaseConfig()` fails closed: if any one of ENDPOINT, BUCKET,
# ACCESS_KEY_ID or SECRET_ACCESS_KEY is missing, creatives returns
# 503 STORAGE_NOT_CONFIGURED and delivery degrades to a 204 no-fill
# rather than serving a broken ad.
#
# Required in production: ENDPOINT, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY.
# Optional: REGION (defaults to us-east-1).
#
# FILEBASE_ENDPOINT=https://s3.filebase.com
# FILEBASE_BUCKET=your_bucket
# FILEBASE_REGION=us-east-1
# FILEBASE_ACCESS_KEY_ID=your_access_key_id
# FILEBASE_SECRET_ACCESS_KEY=your_secret_access_key

# ---------------------------------------------------------------------
# DEPLOY ORDER — this is not optional
# ---------------------------------------------------------------------
# Migration 000021 adds the columns and triggers the telemetry stack reads
# and writes, including ad_serve_log.telemetry_session_id, which the ads
# Edge Function writes on every delivery.
#
# Migration 000022 extends campaign_creatives with the asset columns and
# adds public.campaign_activation_blockers(), which the campaigns Edge
# Function calls before it will set a campaign to active. The ads Edge
# Function reads campaign_creatives.status = 'validated' on every
# delivery. Deploying either function before 000022 is applied means the
# function references columns and an RPC that do not exist yet.
#
# Apply migrations BEFORE deploying functions. Deploying an Edge Function
# that writes a column a migration has not created yet fails the delivery
# insert, and ads/index.ts turns any insert failure into
# 500 INTERNAL_ERROR "Delivery is unavailable." -- which looks like a
# gateway fault and is not one.
#
#   supabase db push                      # migrations first
#   supabase functions deploy campaigns creatives ads telemetry   # then the functions
#
# The `telemetry` function must also be routed by whatever fronts
# api.clirevenue.in, or that path answers 404 "Route not found." and the
# browser reports a preflight failure rather than a missing endpoint.
